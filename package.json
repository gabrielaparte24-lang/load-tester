{
  "name": "load-tester",
  "version": "0.1.0",
  "private": true,
  "description": "Testador de carga e benchmarking de endpoints HTTP com CLI, dashboard e relatórios reproduzíveis",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/core",
    "packages/demo-target",
    "packages/server",
    "packages/cli"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "restart": "node scripts/restart.mjs",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lt": "node packages/cli/bin/lt.js",
    "test": "tsc -b && vitest run",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
