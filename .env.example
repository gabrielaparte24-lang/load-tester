# Copiado para .env por `npm run setup`. Nunca versione o .env.

# Servidor do dashboard/API (escuta sempre em 127.0.0.1)
LT_PORT=4000

# Servidor-alvo de demonstração (npm start -- --with-demo)
LT_DEMO_PORT=4100

# Diretórios (relativos à raiz do projeto; caminhos fora do projeto são recusados)
LT_DATA_DIR=./data
LT_REPORTS_DIR=./reports

# Limites de segurança (tetos padrão; aumentar exige editar aqui ou usar --max-rps / --max-connections)
LT_MAX_RPS=2000
LT_MAX_CONNECTIONS=512
LT_MAX_DURATION=2h

# Alvos permitidos sem confirmação, além de localhost/127.0.0.1/::1.
# Aceita hosts, IPs e faixas CIDR separados por vírgula. Ex.: 10.0.0.0/8,192.168.0.0/16,api.interna.local
ALLOWED_TARGETS=

# Nível de log: debug | info | warn | error
LT_LOG_LEVEL=info

# Segredos usados nos cenários via ${env.NOME} — mascarados em logs, relatórios e dashboard
# API_TOKEN=
